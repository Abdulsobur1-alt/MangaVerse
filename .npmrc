# Build-script policy: pnpm 11 hard-fails a FRESH install if any dependency
# has an ignored build script (ERR_PNPM_IGNORED_BUILDS). ignore-scripts=true
# would mark EVERY package's scripts as ignored and trip that check, so we
# instead approve the script-bearing packages via the allowBuilds map in
# pnpm-workspace.yaml, letting their postinstalls run (sharp, esbuild,
# prisma engines, ...). This matches what production actually needs.
# Note: this also means those approved postinstalls run on local dev
# installs (e.g. @prisma/engines fetches binaries) — do NOT re-add
# ignore-scripts=true; that resurrects ERR_PNPM_IGNORED_BUILDS.

# Registry fetch resilience — keeps Docker builds from dying on flaky
# network connections (ECONNRESET / slow tarballs).
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=1000
fetch-retry-maxtimeout=60000
fetch-timeout=600000
