# pnpm v11 requires explicit approval for build scripts.
# We use --ignore-scripts to skip native module builds during development.
# Run `pnpm rebuild sharp` when you need the full build for production.
ignore-scripts=true

# Registry fetch resilience — keeps Docker builds from dying on flaky
# network connections (ECONNRESET / slow tarballs).
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=1000
fetch-retry-maxtimeout=60000
fetch-timeout=600000

# pnpm 11 strict-dep-builds check fails with ERR_PNPM_IGNORED_BUILDS
# even when ignore-scripts=true (fresh installs only). We never run build
# scripts, so disable the check entirely.
strict-dep-builds=false
