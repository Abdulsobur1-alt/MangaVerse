# ─── MangaVerse Web — environment template ─────────────────────────
# Copy to .env.local for local dev, or set in the root .env for Docker
# (values are inlined at build time — see DEPLOYMENT.md).

# API base URL (the web app calls this for all /api/* requests)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Firebase web API key (optional in dev; sign-in falls back to dev mode)
NEXT_PUBLIC_FIREBASE_API_KEY=
