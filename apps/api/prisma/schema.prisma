generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────

model User {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique
  displayName      String   @map("display_name")
  avatarUrl        String?  @map("avatar_url")
  // Auth-provider UID: the Supabase Auth user id in production, or the
  // user's own db id under dev auth. (Column name predates Supabase; the
  // physical column is unchanged so db-push convergence is a no-op.)
  firebaseUid      String?  @unique @map("firebase_uid")
  coinBalance      Int      @default(0) @map("coin_balance")
  role             String   @default("user") // user | moderator | admin
  subscriptionTier String   @default("free") @map("subscription_tier")
  notificationPrefs Json?   @default("{\"new_chapter\":true,\"reviews\":true,\"milestones\":true,\"achievements\":true}") @map("notification_prefs")
  streakDays       Int      @default(0) @map("streak_days")
  // Personalization prefs (library view mode, preferred genres, etc.) —
  // synced across devices via the API (Phase 7).
  prefs            Json?    @default("{}") @map("prefs")
  // ─── Admin platform (Phase 11) ──────────────────────
  // Granular permission overrides (resource:action pairs) layered on the
  // role's base matrix. Bans/suspensions gate auth middleware.
  rolePermissions  Json?     @map("role_permissions")
  bannedAt         DateTime? @map("banned_at")
  suspendedUntil   DateTime? @map("suspended_until")

  // ─── Identity (Phase 9) ─────────────────────────────
  bio             String?  @db.Text
  location        String?
  website         String?
  // {x, instagram, discord, youtube, twitch} — display labels, no links
  // needed beyond the username/handle the platform expects.
  socialLinks     Json?    @default("{}") @map("social_links")
  bannerUrl       String?  @map("banner_url")
  // Customization: accent hex + profile theme + layout/card style.
  accentColor     String?  @map("accent_color")
  profileTheme    String   @default("aurora") @map("profile_theme") // aurora | midnight | sunset | forest | ocean
  layoutStyle     String   @default("editorial") @map("layout_style") // editorial | compact
  cardStyle       String   @default("rounded") @map("card_style") // rounded | sharp
  // Trust system (Phase 9) — opaque score; only tiers are shown publicly.
  reputation      Int      @default(0)
  // Estimated lifetime reading time (minutes), accrued from page/word counts.
  totalReadingMinutes Int  @default(0) @map("total_reading_minutes")
  lastActiveAt    DateTime? @map("last_active_at")
  // Pinned showcase: {lists: [], reviews: [], collections: []} + pinnedManga ids.
  pinnedItems     Json?    @default("{}") @map("pinned_items")
  pinnedManga     String[] @map("pinned_manga") // Title ids, order = display order

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  bookmarks        Bookmark[]
  pageBookmarks    PageBookmark[]
  userLists        UserList[]
  listLikes        UserListLike[]
  collections      Collection[]
  readingGoals     ReadingGoal[]
  readingProgress  ReadingProgress[]
  following        Follow[]   @relation("UserFollowing")
  followers        Follow[]   @relation("UserFollowers")
  reviewVotes      ReviewVote[]
  coinTransactions CoinTransaction[]
  subscriptions    Subscription[]
  pushSubscriptions PushSubscription[]
  reviews          Review[]
  wikiPages        WikiPage[]
  wikiRevisions    WikiRevision[]
  predictions      PredictionVote[]
  readingClubs     ReadingClubMember[]
  achievements     Achievement[]
  notifications    Notification[]
  announcements    Announcement[]
  announcementDismissals AnnouncementDismissal[]
  auditLogsMade    AuditLog[]         @relation("AuditLogsMade")
  auditLogsTargeted AuditLog[]        @relation("AuditLogsTargeted")
  warningsGiven    UserWarning[]      @relation("WarningsGiven")
  warningsReceived UserWarning[]      @relation("WarningsTargeted")
  ticketsOwned     SupportTicket[]    @relation("TicketsOwned")
  ticketsAssigned  SupportTicket[]    @relation("TicketsAssigned")
  mediaAssets      MediaAsset[]
  contentRevisions ContentRevision[]
  editorialPicks   EditorialPick[]
  flagOverrides    FeatureFlagOverride[]
  settingsUpdated  PlatformSetting[]
  creatorProfile   Creator?
  communityPosts   CommunityPost[]
  postVotes        PostVote[]
  postComments     PostComment[]
  reportsMade      ContentReport[] @relation("ContentReportsMade")
  reportsResolved  ContentReport[] @relation("ContentReportsResolved")
  milestones       ProfileMilestone[]
  wrapped          WrappedReport[]

  @@map("users")
}

// ─── Profile Milestones (Phase 9) ─────────────────────
// The "reading journey" — a life story of a reader. Each row is a first:
// first chapter, first review, first streak, first completed series…
// Detected by services/journey.ts and stamped with an achievedAt; the
// timeline reads oldest → newest as the reader's origin story.

model ProfileMilestone {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String
  title      String
  detail     String?
  emoji      String   @default("✨")
  data       Json?
  achievedAt DateTime @default(now()) @map("achieved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId, achievedAt])
  @@map("profile_milestones")
}

// ─── Wrapped Reports (Phase 9) ────────────────────────
// One per user per year — the annual "MangaVerse Wrapped" snapshot.
// Generated on demand (POST /api/users/me/wrapped), cached here, and
// shareable via /wrapped. `data` holds the full narrative payload.

model WrappedReport {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  year      Int
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([year])
  @@map("wrapped_reports")
}

// ─── Titles / Manga ────────────────────────────────────

model Title {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique
  title            String
  alternativeTitles String?  @map("alternative_titles")
  type             String
  status           String   @default("ongoing")
  genres           String[]
  tags             String[]
  author           String?
  artist           String?
  coverUrl         String?  @map("cover_url")
  bannerUrl        String?  @map("banner_url")
  synopsis         String?
  rating           Float?
  totalChapters    Int?     @map("total_chapters")
  releaseYear      Int?     @map("release_year")
  sourceUrl        String?  @map("source_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  chapters         Chapter[]
  bookmarks        Bookmark[]
  pageBookmarks    PageBookmark[]
  collectionItems  CollectionItem[]
  listItems        UserListItem[]
  reviews          Review[]
  wikiPages        WikiPage[]
  predictions      Prediction[]
  communityPosts   CommunityPost[]
  editorialPicks   EditorialPick[]

  @@index([slug])
  @@index([type, status])
  @@index([genres], type: Gin)
  @@map("titles")
}

// ─── Chapters ──────────────────────────────────────────

model Chapter {
  id          String    @id @default(uuid()) @db.Uuid
  titleId     String    @map("title_id") @db.Uuid
  number      Float
  title       String?
  pageCount   Int?      @map("page_count")
  coinLocked  Boolean   @default(false) @map("coin_locked")
  freeAt      DateTime? @map("free_at")
  sourceUrl   String?   @map("source_url")
  // Direct page image URLs for staff-uploaded chapters (Studio). When set,
  // the reader serves these instead of MangaDex/placeholder pages.
  pageUrls    String[]  @default([]) @map("page_urls")
  // Prose content for light novels/novels (and any text-based chapters).
  // NULL for image-based chapters (manga/manhwa/manhua).
  contentText String?   @map("content_text") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  series          Title             @relation(fields: [titleId], references: [id], onDelete: Cascade)
  readingProgress ReadingProgress[]
  pageBookmarks   PageBookmark[]

  @@unique([titleId, number])
  @@index([titleId, number])
  @@map("chapters")
}

// ─── Bookmarks / Library ───────────────────────────────

model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  titleId   String   @map("title_id") @db.Uuid
  listName  String   @default("Reading") @map("list_name")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([userId, titleId])
  @@map("bookmarks")
}

// ─── Custom Collections (Phase 7) ─────────────────────
// User-curated shelves beyond the five default library lists.
// "Weekend Reads", "Peak Fiction", "Emotional Damage" — any grouping.
// Items are (collectionId, titleId) unique; ordering by sort_order then
// insertion time. `isPrivate` is the privacy flag; public sharing is a
// Phase 7 roadmap item (the field is already future-ready).

model Collection {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  name        String
  description String?          @db.Text
  coverUrl    String?          @map("cover_url")
  tags        String[]
  isPrivate   Boolean          @default(true) @map("is_private")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId, createdAt])
  @@map("collections")
}

model CollectionItem {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  titleId      String   @map("title_id") @db.Uuid
  note         String?
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  title      Title      @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([collectionId, titleId])
  @@index([titleId])
  @@map("collection_items")
}

// ─── User Lists (Phase 8) ───────────────────────────────
// Curated, shareable public lists — "Top Romance Manga", "Best Villains",
// "Must Read Before 2027". Unlike private Collections (a shelf), lists are
// public by default, likeable, and browsable by the community. Items carry
// an optional note; sorting is by sort_order then insertion. Collaboration
// is future-ready (the schema is flat and shareable).

model UserList {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  name        String
  description String?        @db.Text
  tags        String[]
  coverUrl    String?        @map("cover_url")
  isPublic    Boolean        @default(true) @map("is_public")
  likeCount   Int            @default(0) @map("like_count")
  viewCount   Int            @default(0) @map("view_count")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items UserListItem[]
  likes UserListLike[]

  @@index([userId, createdAt])
  @@index([isPublic, likeCount])
  @@map("user_lists")
}

model UserListItem {
  id        String   @id @default(uuid()) @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  titleId   String   @map("title_id") @db.Uuid
  note      String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  list  UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  title Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([listId, titleId])
  @@index([titleId])
  @@map("user_list_items")
}

model UserListLike {
  id        String   @id @default(uuid()) @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  list UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@map("user_list_likes")
}

// ─── Page Bookmarks (Phase 7 completion) ───────────────
// Rich, server-synced marks at the page level: a quote, a scene, a note,
// a panel — attached to a chapter+page and optionally filed under a
// user-defined folder with tags. "B" in the reader creates one of these;
// they sync across devices through the API (no more localStorage-only
// marks). Folders are a plain string (normalized by the client) — no
// separate table needed, but the shape is future-ready for one.

model PageBookmark {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  titleId    String   @map("title_id") @db.Uuid
  chapterId  String   @map("chapter_id") @db.Uuid
  pageNumber Int      @map("page_number")
  quote      String?  @db.Text
  note       String?  @db.Text
  folder     String?  // null = uncategorized
  tags       String[]
  createdAt  DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   Title   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, folder])
  @@map("page_bookmarks")
}

// ─── Reading Goals (Phase 7) ─────────────────────────
// A goal is (type, target) with a human `title`. Progress is always derived
// from reading data at request time — no incremental counters to drift.
// Types: chapters_week (calendar week), chapters_day, chapters_total,
// series_total (distinct series with ≥1 completed chapter), series_completed
// (finished the final chapter), streak_days (maintain a streak ≥ target).

model ReadingGoal {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  type      String // chapters_week | chapters_day | chapters_total | series_total | series_completed | streak_days
  target    Int
  active    Boolean   @default(true)
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@map("reading_goals")
}

// ─── Reading Progress ──────────────────────────────────

model ReadingProgress {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  chapterId  String   @map("chapter_id") @db.Uuid
  pageNumber Int      @default(0) @map("page_number")
  completed  Boolean  @default(false)
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@map("reading_progress")
}

// ─── Coin Transactions ─────────────────────────────────

model CoinTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  amount      Int
  type        String
  referenceId String?  @map("reference_id")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coin_transactions")
}

// ─── Community Posts / Votes / Comments ───────────────

model CommunityPost {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  titleId   String?  @map("title_id") @db.Uuid
  title     String
  body      String   @db.Text
  tag       String   @default("discussion") // theory | prediction | discussion | review
  views     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  series   Title?        @relation(fields: [titleId], references: [id], onDelete: SetNull)
  votes    PostVote[]
  comments PostComment[]

  @@index([tag])
  @@index([createdAt])
  @@map("community_posts")
}

model PostVote {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // One reaction per user per post. upvote is the classic "like";
  // helpful/insightful/funny/agree/love are the meaningful set (Phase 8).
  reaction  String   @default("upvote")
  createdAt DateTime @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_votes")
}

model PostComment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  // Threaded replies: null = top-level comment (Phase 8).
  parentId  String?   @map("parent_id") @db.Uuid
  body      String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  post     CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   PostComment?  @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  children PostComment[] @relation("CommentTree")

  @@index([postId])
  @@index([parentId])
  @@map("post_comments")
}

// ─── Social Graph (Phase 8) ──────────────────────────
// Directed follow edges. Two rows between the same pair are impossible
// (unique on (followerId, followingId)); mutual follow is two rows.

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// ─── Content Reports (Flags) ──────────────────────────
// Users flag abusive posts, comments, and wiki pages for review. One report
// per (reporter, contentType, target) — duplicates are rejected with 409.
// Moderators move reports through pending → resolved | dismissed.

model ContentReport {
  id           String    @id @default(uuid()) @db.Uuid
  reporterId   String    @map("reporter_id") @db.Uuid
  contentType  String    @map("content_type") // post | comment | wiki
  targetId     String    @map("target_id") @db.Uuid
  reason       String
  details      String?
  status       String    @default("pending") // pending | resolved | dismissed
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id") @db.Uuid

  reporter User  @relation("ContentReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  resolver User? @relation("ContentReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, contentType, targetId])
  @@index([status, createdAt])
  @@map("content_reports")
}

// ─── Subscriptions ─────────────────────────────────────

model Subscription {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  tier         String
  stripeSubId  String?  @map("stripe_sub_id")
  startsAt     DateTime @map("starts_at")
  endsAt       DateTime? @map("ends_at")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── Reviews ───────────────────────────────────────────

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  titleId      String   @map("title_id") @db.Uuid
  rating       Int
  // Optional headline — reviews read like blog posts (Phase 8).
  headline     String?
  // When true the body is blurred until the reader reveals it.
  spoiler      Boolean  @default(false) @map("spoiler")
  subScores    Json?    @map("sub_scores")
  body         String?
  helpfulCount Int      @default(0) @map("helpful_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title Title        @relation(fields: [titleId], references: [id], onDelete: Cascade)
  votes ReviewVote[]

  @@unique([userId, titleId])
  @@map("reviews")
}

// ─── Review Helpful Votes (Phase 8) ──────────────────
// Per-user helpful vote (one per review, toggleable). Counts are derived
// from this table — helpfulCount on Review is kept denormalized for fast
// list sorts and updated in the same transaction as the vote.

model ReviewVote {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_votes")
}

// ─── Wiki Pages ────────────────────────────────────────

model WikiPage {
  id         String   @id @default(uuid()) @db.Uuid
  titleId    String   @map("title_id") @db.Uuid
  slug       String
  contentMd  String   @map("content_md") @db.Text
  authorId   String   @map("author_id") @db.Uuid
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  title     Title          @relation(fields: [titleId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id])
  revisions WikiRevision[]

  @@unique([titleId, slug])
  @@map("wiki_pages")
}

// ─── Wiki Revision History ────────────────────────────
// Every wiki edit appends a revision row, preserving who wrote each version.
// (Previously the single WikiPage.authorId was overwritten on each edit,
// losing prior-editor history.)

model WikiRevision {
  id        String   @id @default(uuid()) @db.Uuid
  wikiId    String   @map("wiki_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  contentMd String   @map("content_md") @db.Text
  version   Int
  createdAt DateTime @default(now()) @map("created_at")

  wiki   WikiPage @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  author User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([wikiId, version])
  @@index([wikiId, createdAt])
  @@map("wiki_revisions")
}

// ─── Predictions ───────────────────────────────────────

model Prediction {
  id         String   @id @default(uuid()) @db.Uuid
  titleId    String   @map("title_id") @db.Uuid
  question   String
  options    String[]
  resolvesAt DateTime? @map("resolves_at")
  result     String?
  createdAt  DateTime @default(now()) @map("created_at")

  title Title            @relation(fields: [titleId], references: [id], onDelete: Cascade)
  votes PredictionVote[]

  @@map("predictions")
}

model PredictionVote {
  id           String   @id @default(uuid()) @db.Uuid
  predictionId String   @map("prediction_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  option       String
  coinsStaked  Int      @default(0) @map("coins_staked")
  createdAt    DateTime @default(now()) @map("created_at")

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([predictionId, userId])
  @@map("prediction_votes")
}

// ─── Reading Clubs ─────────────────────────────────────

model ReadingClub {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  creatorId        String   @map("creator_id") @db.Uuid
  currentChapterId String?  @map("current_chapter_id") @db.Uuid
  memberCount      Int      @default(0) @map("member_count")
  createdAt        DateTime @default(now()) @map("created_at")

  members ReadingClubMember[]

  @@map("reading_clubs")
}

model ReadingClubMember {
  id        String   @id @default(uuid()) @db.Uuid
  clubId    String   @map("club_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  joinedAt  DateTime @default(now()) @map("joined_at")

  club ReadingClub @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@map("reading_club_members")
}

// ─── Achievements ──────────────────────────────────────

model Achievement {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  badgeId   String   @map("badge_id")
  earnedAt  DateTime @default(now()) @map("earned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("achievements")
}

// ─── Push Subscriptions (Web Push) ─────────────────────
// Browser push notification subscriptions, one row per endpoint.

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ─── Notifications ─────────────────────────────────────

// ─── Notifications (Phase 10) ───────────────────────────
// The full engagement model: every notification carries a category
// (chapters / social / community / achievements / system / reminders),
// a priority (critical > high > normal > silent > background) that
// drives push/email behavior, a structured data payload, and a dedupe
// key so burst events coalesce instead of spamming.

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String    // "new_chapter", "review_added", "reply", "achievement", "reminder"...
  category   String    @default("system") // chapters | social | community | achievements | system | reminders
  priority   String    @default("normal") // critical | high | normal | silent | background
  title      String
  body       String?
  link       String?   // Relative URL to navigate to (e.g., /title/solo-leveling/reader/abc)
  imageUrl   String?   @map("image_url")
  data       Json?     // Structured payload (actor name, chapter number, badge id...)
  dedupeKey  String?   @map("dedupe_key") // Coalesces burst events (e.g. "new_chapter:title-123")
  read       Boolean   @default(false)
  pinnedAt   DateTime? @map("pinned_at")
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([userId, category])
  @@index([dedupeKey])
  @@map("notifications")
}

// ─── Announcements (Phase 10) ───────────────────────────
// Dismissible in-app banners: product updates, maintenance, events,
// seasonal themes, reading challenges. Targeted by audience; dismissed
// per-user so analytics keep working.

model Announcement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  body        String?  @db.Text
  variant     String   @default("info") // info | success | warning | seasonal | maintenance
  audience    String   @default("all")  // all | logged_in | moderators
  link        String?
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  dismissible Boolean  @default(true)
  active      Boolean  @default(true)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy  User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  dismissals AnnouncementDismissal[]

  @@index([active, endsAt])
  @@map("announcements")
}

model AnnouncementDismissal {
  id             String   @id @default(uuid()) @db.Uuid
  announcementId String   @map("announcement_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  dismissedAt    DateTime @default(now()) @map("dismissed_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_dismissals")
}

// ─── Notification Templates (Phase 10) ──────────────────
// Admin-editable copy for every notification type. Tokens like
// {title} / {chapter} are substituted at send time.

model NotificationTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  name      String
  type      String
  category  String   @default("system")
  priority  String   @default("normal")
  title     String   // Template with {tokens}
  body      String?  @db.Text
  link      String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

// ═══ Phase 11 — Admin Platform ═══════════════════════

// ─── Audit Logs ───────────────────────────────────────
// Every critical action is logged: role changes, publishes, bans,
// feature toggles, settings edits, moderator resolutions, impersonation.

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   // e.g. "role.change", "title.publish", "user.ban"
  resource     String   // e.g. "user", "title", "chapter", "feature_flag"
  resourceId   String?  @map("resource_id")
  targetUserId String?  @map("target_user_id") @db.Uuid
  details      Json?
  ip           String?
  createdAt    DateTime @default(now()) @map("created_at")

  actor      User? @relation("AuditLogsMade", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditLogsTargeted", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([resource, action])
  @@index([actorId])
  @@map("audit_logs")
}

// ─── Feature Flags ────────────────────────────────────
// Kill switches, beta features, experiments and seasonal events — with
// rollout percentages and per-user overrides.

model FeatureFlag {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  name         String
  description  String?
  enabled      Boolean  @default(false)
  rolloutPct   Int      @default(100) @map("rollout_pct")
  environments String[] @default([])
  updatedById  String?  @map("updated_by_id") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at")

  overrides FeatureFlagOverride[]

  @@index([enabled])
  @@map("feature_flags")
}

model FeatureFlagOverride {
  id      String  @id @default(uuid()) @db.Uuid
  flagId  String  @map("flag_id") @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  enabled Boolean

  flag FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([flagId, userId])
  @@map("feature_flag_overrides")
}

// ─── Support Tickets ──────────────────────────────────
// Internal ticketing with assignment, priority and threaded internal notes.

model SupportTicket {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  subject       String
  body          String   @db.Text
  status        String   @default("open") // open | in_progress | resolved | closed
  priority      String   @default("normal") // low | normal | high | urgent
  assigneeId    String?  @map("assignee_id") @db.Uuid
  internalNotes Json?    @default("[]") @map("internal_notes") // [{actorName, body, at}]
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user     User  @relation("TicketsOwned", fields: [userId], references: [id], onDelete: Cascade)
  assignee User? @relation("TicketsAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status, priority])
  @@index([assigneeId])
  @@map("support_tickets")
}

// ─── User Warnings / Moderation ───────────────────────
// Warn → mute → suspend → ban ladder, each an auditable record.

model UserWarning {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  actorId       String?   @map("actor_id") @db.Uuid
  reason        String
  severity      String    // notice | warning | mute | suspend | ban
  durationHours Int?      @map("duration_hours")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")

  user  User? @relation("WarningsTargeted", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("WarningsGiven", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, active])
  @@index([severity])
  @@map("user_warnings")
}

// ─── Media Library ────────────────────────────────────
// Centralized asset manager: covers, banners, icons, illustrations.

model MediaAsset {
  id          String   @id @default(uuid()) @db.Uuid
  url         String
  type        String   @default("image") // image | banner | cover | icon | video
  name        String?
  size        Int?     // bytes
  width       Int?
  height      Int?
  tags        String[] @default([])
  folder      String?
  usageCount  Int      @default(0) @map("usage_count")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([type, folder])
  @@map("media_assets")
}

// ─── Content Revisions ────────────────────────────────
// Generic version history for CMS entities (title, chapter, editorial
// pick) — supports preview of old versions and rollback.

model ContentRevision {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type") // title | chapter | editorial_pick
  entityId   String   @map("entity_id")
  version    Int
  data       Json
  note       String?
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId, version])
  @@index([entityType, entityId])
  @@map("content_revisions")
}

// ─── Editorial Picks / Featured Content ───────────────

model EditorialPick {
  id          String    @id @default(uuid()) @db.Uuid
  titleId     String    @map("title_id") @db.Uuid
  position    Int       @default(0)
  label       String?
  active      Boolean   @default(true)
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  title     Title @relation(fields: [titleId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active, position])
  @@map("editorial_picks")
}

// ─── Platform Settings ────────────────────────────────
// Branding, homepage, SEO, maintenance mode, integrations… key/value.

model PlatformSetting {
  id          String    @id @default(uuid()) @db.Uuid
  key         String    @unique
  value       Json
  updatedById String?   @map("updated_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("platform_settings")
}

// ─── Creators ──────────────────────────────────────────

model Creator {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @unique @map("user_id") @db.Uuid
  displayName     String @map("display_name")
  bio             String?
  revenueSharePct Float  @default(0.7) @map("revenue_share_pct")
  totalEarned     Int    @default(0) @map("total_earned")
  payoutWallet    String? @map("payout_wallet")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creators")
}
