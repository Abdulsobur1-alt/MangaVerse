# ─── MangaVerse API — environment template ─────────────────────────
# Copy to .env and fill in. (In Docker, these come from the root .env
# via docker-compose.yml — see DEPLOYMENT.md.)

# PostgreSQL (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mangaverse

# Redis (BullMQ queues + caching)
REDIS_URL=redis://localhost:6379

# Meilisearch (full-text search; falls back to DB search when unreachable)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=mangaverse-dev-key

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# Supabase Auth — production auth (optional in dev; dev_ tokens work without it).
# From the Supabase dashboard → Project settings → API keys.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Storage — Studio uploads (covers, banners, chapter pages).
# REQUIRED for durable uploads in prod (Render/VPS disk is ephemeral;
# without the service-role key uploads fall back to local disk and can be
# wiped on redeploy). Server-only secret — never expose to the browser.
# From Supabase → Project settings → API keys → service_role (secret).
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Bucket for uploaded images (created automatically on first upload).
# SUPABASE_STORAGE_BUCKET=mangaverse

# Web Push (VAPID) — generate keys with:
#   pnpm --filter @mangaverse/api webpush:generate-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mangaverse.app
