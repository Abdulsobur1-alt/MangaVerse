# MangaVerse Mobile Environment Variables
# Copy this file to .env and fill in your values (or set EXPO_PUBLIC_* in
# your EAS build profile — see eas.json and DEPLOYMENT.md)

# Backend API URL (no /api suffix — the app appends it)
# Android emulator: http://10.0.2.2:3001
# iOS simulator: http://localhost:3001
# Physical device: http://<your-computer-ip>:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# Supabase Auth (optional in dev; sign-in falls back to dev mode)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
