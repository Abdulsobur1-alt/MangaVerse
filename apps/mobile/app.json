{
  "expo": {
    "name": "MangaVerse",
    "slug": "mangaverse",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.svg",
    "userInterfaceStyle": "dark",
    "scheme": "mangaverse",
    "splash": {
      "image": "./assets/splash.svg",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mangaverse.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.svg",
        "backgroundColor": "#0a0a14"
      },
      "package": "com.mangaverse.app",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ]
    },
    "extra": {
      "updater": {
        "enabled": false,
        "checkAutomatically": "ON_ERROR_RECOVERY"
      },
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "971dca53-9fc3-49bf-9862-e567c4ab8201"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router"
    ],
    "owner": "abdulsobur1"
  }
}
