{
  "expo": {
    "name": "MangaVerse",
    "slug": "mangaverse",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "mangaverse",
    "splash": {
      "backgroundColor": "#0a0a14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mangaverse.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a14"
      },
      "package": "com.mangaverse.app"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router"
    ]
  }
}
